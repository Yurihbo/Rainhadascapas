rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAnonymousClient() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    match /sharedWorkspaces/main {
      // Operação privada por link: o app autentica cada dispositivo anonimamente.
      // A identidade anônima autoriza o cliente sem expor tela de login.
      allow read, create, update: if isAnonymousClient();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
